{
  "manifest_version": 3,
  "name": "Unviewable: Save jobs and check your resume match",
  "short_name": "Unviewable",
  "version": "0.2.0",
  "description": "Save any job posting to your Unviewable tracker in one click and score your resume against it.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this job to Unviewable",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.unviewable.online/*",
    "http://localhost:3000/*",

    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.workable.com/*",
    "https://*.recruitee.com/*",
    "https://*.breezy.hr/*",
    "https://*.bamboohr.com/*",
    "https://*.teamtailor.com/*",
    "https://*.zohorecruit.com/*",
    "https://*.zohorecruit.in/*",
    "https://*.keka.com/*",
    "https://*.darwinbox.in/*",
    "https://*.freshteam.com/*"
  ]
}
